---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/apply.css';
---
<BaseLayout
  title="Apply | Cleaning Jobs NZ"
  description="Apply once for Spruce-standard cleaning work in New Zealand. Suitable applicants complete onboarding and become eligible for work allocation."
  path="/apply/"
  ogDescription="Apply once for Spruce-standard cleaning work in New Zealand."
  applyHref="#apply-form"
>
  <Fragment slot="head">
  <script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Apply | Cleaning Jobs NZ",
    "description": "Apply once for Spruce-standard cleaning work in New Zealand. Suitable applicants complete onboarding and become eligible for suitable work allocation.",
    "url": "https://cleaningjobs.co.nz/apply/",
    "@id": "https://cleaningjobs.co.nz/apply/#webpage",
    "dateModified": "2026-08-22",
    "inLanguage": "en-NZ",
    "isPartOf": { "@id": "https://cleaningjobs.co.nz/#website" },
    "about": { "@id": "https://cleaningjobs.co.nz/#organization" },
    "publisher": { "@id": "https://cleaningjobs.co.nz/#organization" },
    "breadcrumb": { "@id": "https://cleaningjobs.co.nz/apply/#breadcrumb" }
  }
  </script>
  <script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": "https://cleaningjobs.co.nz/apply/#breadcrumb",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://cleaningjobs.co.nz/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Apply",
        "item": "https://cleaningjobs.co.nz/apply/"
      }
    ]
  }
  </script>
  </Fragment>

  <main id="main">
    <section class="hero">
      <div class="wrap">
        <span class="eyebrow">Apply</span>
        <h1>Apply once for Spruce-standard cleaning work.</h1>
        <p class="lead">One short application. We review every application individually and contact you if there&rsquo;s a suitable next step. You only need to apply once.</p>
      </div>
    </section>

    <section class="block" id="apply-form">
      <div class="wrap">
        <div class="apply-layout">
          <div>
            <div class="form-success" id="formSuccess" role="status" aria-live="polite">
              <h2>Thanks, we&rsquo;ve received your application.</h2>
              <p>We review every application individually and will be in touch if there&rsquo;s a suitable next step. If you need to reach us in the meantime, email <a href="mailto:hello@cleaningjobs.co.nz">hello@cleaningjobs.co.nz</a>.</p>
            </div>

            <form class="apply-form" id="applyForm" action="/api/apply/" method="post" novalidate>
              <div class="form-msg" id="formError" role="alert"></div>
              <div aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden"><label>Company<input type="text" name="company" tabindex="-1" autocomplete="off"></label></div>
              <input type="hidden" name="source_referrer" id="sourceReferrer">
              <input type="hidden" name="source_params" id="sourceParams">

              <fieldset>
                <legend>About you</legend>
                <div class="field-grid two">
                  <div class="field full"><label for="full_name">Full name <span class="req">*</span></label><input id="full_name" name="full_name" type="text" autocomplete="name" required></div>
                  <div class="field"><label for="email">Email <span class="req">*</span></label><input id="email" name="email" type="email" autocomplete="email" required></div>
                  <div class="field"><label for="phone">Phone <span class="req">*</span></label><input id="phone" name="phone" type="tel" autocomplete="tel" required></div>
                  <div class="field"><label for="suburb">Suburb or town <span class="req">*</span></label><input id="suburb" name="suburb" type="text" autocomplete="address-level2" required></div>
                  <div class="field"><label for="region">Region <span class="req">*</span></label>
                    <select id="region" name="region" required>
                      <option value="" selected disabled>Select a region</option>
                <option>Northland</option>
                <option>Auckland</option>
                <option>Waikato</option>
                <option>Bay of Plenty</option>
                <option>Gisborne</option>
                <option>Hawke&rsquo;s Bay</option>
                <option>Taranaki</option>
                <option>Manawatū-Whanganui</option>
                <option>Wellington</option>
                <option>Tasman</option>
                <option>Nelson</option>
                <option>Marlborough</option>
                <option>West Coast</option>
                <option>Canterbury</option>
                <option>Otago</option>
                <option>Southland</option>
                    </select>
                  </div>
                </div>
              </fieldset>

              <fieldset>
                <legend>Your eligibility</legend>
                <div class="field-grid">
                  <div class="field"><label for="right_to_work">Right to work in New Zealand <span class="req">*</span></label>
                    <select id="right_to_work" name="right_to_work" required>
                      <option value="" selected disabled>Select one</option>
                      <option>I&rsquo;m a NZ citizen or resident</option>
                      <option>I have a valid NZ work visa</option>
                      <option>Not yet</option>
                      <option>Not sure</option>
                    </select>
                  </div>
                  <div class="field-grid two">
                    <div class="field"><label for="experience">Cleaning experience <span class="req">*</span></label>
                      <select id="experience" name="experience" required>
                        <option value="" selected disabled>Select one</option>
                        <option>None yet</option>
                        <option>Less than 1 year</option>
                        <option>1 to 3 years</option>
                        <option>3+ years</option>
                      </select>
                    </div>
                    <div class="field"><label for="transport">Own vehicle <span class="req">*</span></label>
                      <select id="transport" name="transport" required>
                        <option value="" selected disabled>Select one</option>
                        <option>I have my own vehicle</option>
                      </select>
                    </div>
                  </div>
                </div>
              </fieldset>

              <fieldset>
                <legend>The work</legend>
                <div class="field full" style="margin-bottom:18px;">
                  <label>Which work are you interested in? <span class="req">*</span></label>
                  <div class="choice-grid" id="workTypes">
                    <label class="choice"><input type="checkbox" name="work_types" value="Residential"><span>Residential cleaning</span></label>
                    <label class="choice"><input type="checkbox" name="work_types" value="Commercial"><span>Office &amp; commercial</span></label>
                    <label class="choice"><input type="checkbox" name="work_types" value="Specialist"><span>Specialist &amp; trades-adjacent</span></label>
                    <label class="choice"><input type="checkbox" name="work_types" value="Unsure"><span>Not sure yet</span></label>
                  </div>
                </div>
                <div class="field-grid two">
                  <div class="field"><label for="availability">General availability</label>
                    <select id="availability" name="availability">
                      <option selected>Flexible</option>
                      <option>Weekdays</option>
                      <option>Weekends</option>
                      <option>Mornings</option>
                      <option>Evenings</option>
                    </select>
                  </div>
                  <div class="field"><label for="applying_as">Applying as</label>
                    <select id="applying_as" name="applying_as">
                      <option selected>An individual</option>
                      <option>A small team</option>
                      <option>A cleaning partnership</option>
                    </select>
                  </div>
                </div>
              </fieldset>

              <fieldset>
                <legend>Anything else</legend>
                <div class="field full">
                  <label for="message">Tell us anything that helps <span class="hint">(optional)</span></label>
                  <textarea id="message" name="message" placeholder="Areas you can cover, the kind of work you enjoy, anything about your situation."></textarea>
                </div>
              </fieldset>

              <div class="consent" style="margin-bottom:20px;">
                <input id="consent" name="consent" type="checkbox" required>
                <label for="consent">I agree to be contacted about my application and have read the <a href="/legal/#privacy">Privacy notice</a>. <span class="req">*</span></label>
              </div>

              <div class="apply-submit">
                <button class="btn btn-primary" type="submit" id="applySubmit">Submit application <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                <p class="apply-note">Applying takes a few minutes. Work is not guaranteed. Allocation depends on demand, suitability, availability, and certification.</p>
              </div>
            </form>
          </div>

          <aside class="apply-aside" aria-label="What happens next">
            <div class="aside-card">
              <h3>What happens next</h3>
              <div class="aside-step"><span class="n">1</span><div><div class="t">Apply online</div><div class="d">Send us this one short application.</div></div></div>
              <div class="aside-step"><span class="n">2</span><div><div class="t">We review individually</div><div class="d">Each application is checked against current demand and suitability.</div></div></div>
              <div class="aside-step"><span class="n">3</span><div><div class="t">Onboard and certify</div><div class="d">Suitable applicants train to the Spruce standard.</div></div></div>
              <div class="aside-step"><span class="n">4</span><div><div class="t">Eligible for suitable work</div><div class="d">Considered for work by location, demand, availability, and certification.</div></div></div>
            </div>
            <div class="aside-card aside-contact">
              <h3>Questions before applying?</h3>
              <a href="mailto:hello@cleaningjobs.co.nz">hello@cleaningjobs.co.nz</a>
              <a href="tel:+64800737333">0800 737 333</a>
              <div class="aside-links"><a href="/how-it-works/">How it works</a> &nbsp;&middot;&nbsp; <a href="/faq/">Read the FAQ</a></div>
            </div>
            <p class="aside-disclaimer">Cleaning Jobs is the recruitment and onboarding arm of The Spruce Company. Applying does not guarantee work. Allocation depends on demand, suitability, availability, and certification.</p>
          </aside>
        </div>
      </div>
    </section>
  </main>

  <Fragment slot="scripts">
  <script is:inline>
    (function () {
      var form = document.getElementById('applyForm');
      if (!form) return;
      var err = document.getElementById('formError');
      var ok = document.getElementById('formSuccess');
      var btn = document.getElementById('applySubmit');
      function showError(msg) { err.classList.add('error'); err.textContent = msg; err.style.display = 'block'; err.scrollIntoView({behavior:'smooth', block:'center'}); }

      // Source attribution for the first-party application record. Deliberately
      // minimal: referrer origin+path only (no query), and an allowlist of campaign
      // params — arbitrary query strings can carry identifiers or tokens.
      var refField = document.getElementById('sourceReferrer');
      var paramsField = document.getElementById('sourceParams');
      if (refField && document.referrer) {
        try { var u = new URL(document.referrer); refField.value = (u.origin + u.pathname).slice(0, 300); } catch (e) {}
      }
      if (paramsField) {
        var sp = new URLSearchParams(location.search);
        var keep = ['from', 'utm_source', 'utm_medium', 'utm_campaign'];
        var out = [];
        for (var k = 0; k < keep.length; k++) {
          var v = sp.get(keep[k]);
          if (v) out.push(keep[k] + '=' + v.slice(0, 100));
        }
        paramsField.value = out.join('&').slice(0, 400);
      }

      // Preselect the region when the visitor arrived from a city page (?from= or referrer).
      var regionSelect = document.getElementById('region');
      if (regionSelect && !regionSelect.value) {
        var hint = (new URLSearchParams(location.search).get('from') || '') + ' ' + (document.referrer || '');
        var regionMap = [['auckland', 'Auckland'], ['wellington', 'Wellington'], ['hamilton', 'Waikato'], ['tauranga', 'Bay of Plenty']];
        for (var i = 0; i < regionMap.length; i++) {
          if (hint.toLowerCase().indexOf(regionMap[i][0]) !== -1) { regionSelect.value = regionMap[i][1]; break; }
        }
      }
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        err.style.display = 'none';
        var checked = form.querySelectorAll('input[name="work_types"]:checked').length;
        if (checked === 0) { showError('Please choose at least one type of work.'); return; }
        if (!form.checkValidity()) { form.reportValidity(); return; }
        btn.disabled = true; btn.style.opacity = '.7'; btn.textContent = 'Submitting\u2026';
        var fd = new FormData(form);
        var payload = {};
        fd.forEach(function (value, key) {
          if (key === 'work_types') { (payload.work_types = payload.work_types || []).push(value); }
          else { payload[key] = value; }
        });
        fetch(form.action, { method: 'POST', headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' }, body: JSON.stringify(payload) })
          .then(function (r) { if (!r.ok) throw new Error(); form.style.display = 'none'; ok.style.display = 'block'; ok.scrollIntoView({behavior:'smooth', block:'center'}); })
          .catch(function () { btn.disabled = false; btn.style.opacity = '1'; btn.textContent = 'Submit application'; showError('We could not submit your application just now. Please email hello@cleaningjobs.co.nz or call 0800 737 333.'); });
      });
    })();
  </script>
  </Fragment>
</BaseLayout>
