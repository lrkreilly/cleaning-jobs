---
// Custom 404 — replaces Vercel's unbranded plain-text default.
import '../styles/404.css';
---
<!DOCTYPE html>
<html lang="en-NZ">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <title>Page not found | Cleaning Jobs NZ</title>
  <meta name="robots" content="noindex" />
  <meta name="theme-color" content="#f7f5f0" />
  <link rel="preload" href="/fonts/plus-jakarta-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <a class="brand" href="/">Cleaning Jobs</a>
  <p class="code">404</p>
  <h1>That page is not here.</h1>
  <p class="lead">The link may be old or mistyped. The application itself is one page, and it is still open.</p>
  <div class="actions">
    <a class="btn btn-primary" href="/apply/">Start an application</a>
    <a class="btn btn-secondary" href="/">Go to the homepage</a>
  </div>
  <ul class="links">
    <li><a href="/cleaning-jobs-auckland/">Cleaning jobs in Auckland</a></li>
    <li><a href="/how-it-works/">How it works</a></li>
    <li><a href="/faq/">FAQ</a></li>
    <li><a href="/about/">About</a></li>
  </ul>
</body>
</html>
