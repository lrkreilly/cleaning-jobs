// Cloudflare Workers configuration for cleaningjobs.co.nz (docs/cloudflare-setup.md).
// Deploy with `npm run deploy`: astro build, then wrangler deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cleaning-jobs",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-23",
  // api/apply.js reads its settings from process.env, which nodejs_compat fills from the Workers
  // secrets: RESEND_API_KEY, the Upstash store (KV_REST_API_URL and KV_REST_API_TOKEN),
  // APP_RECORD_TTL_DAYS, and optionally APPLY_TO and APPLY_FROM (docs/cloudflare-setup.md).
  "compatibility_flags": ["nodejs_compat"],
  // Only the Custom Domains reach the Worker: no workers.dev or preview addresses, which would
  // publish duplicate copies of the site.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Every request goes through worker/index.js, which handles the redirects, the form function
    // and the headers.
    "run_worker_first": true
  }
}
